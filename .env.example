# Backend environment variables. Never commit your real .env file.
PORT=3000
NODE_ENV=development

# Public website deployed on Netlify, without trailing slash.
FRONTEND_URL=https://YOUR-SITE.netlify.app

# Supabase > Project Settings > Database > Connection string (URI).
# Prefer the Session Pooler connection string for a persistent Node server.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
PG_SSL=true

# Xendit API keys: use TEST key first, LIVE key only after account activation and testing.
# Secret API Key must stay in backend environment variables.
XENDIT_SECRET_KEY=xnd_development_REPLACE_ME
# Copy the Verification Token from Xendit Dashboard > Settings/Webhooks.
XENDIT_CALLBACK_TOKEN=REPLACE_WITH_XENDIT_WEBHOOK_VERIFICATION_TOKEN

# Generate a long random secret, 32+ characters. Used only for admin APIs.
ADMIN_KEY=replace-with-a-long-random-secret-at-least-32-characters

# Event configuration
EVENT_NAME=GENFEST IKMAB-K 2026 - FUN RUN
TICKET_PRICE=130000
TICKET_LIMIT=200
EVENT_DATE=15 November 2026
EVENT_LOCATION=Area Kampus 2 UIN K.H. Abdurrahman Wahid Pekalongan
